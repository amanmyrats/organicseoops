# Backend template. ./backend-dev.sh setup creates backend/.env privately.
# Production: backend/.env.prod (DEBUG=0, separate secrets, real HTTPS hosts).
# Never place backend secrets in frontend/src/environments/*.ts.
COMPOSE_PROJECT_NAME=organicseoops-dev
PROXY_PORT=18000
# Existing Bookworm installations must follow deploy/postgres/README.md first.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
FRONTEND_ORIGIN=http://127.0.0.1:4200
API_ORIGIN=
# Optional public analytics stays off until the complete collector/public release gates.
# Absolute read-only checked build artifact path inside API; canonical parser SHA, not file SHA.
PUBLIC_ANALYTICS_ENABLED=0
PUBLIC_ANALYTICS_POLICY_FILE=
PUBLIC_ANALYTICS_POLICY_SHA256=
# CONTACT remains off until reviewed retention and public service/disclosure gates are satisfied.
PUBLIC_CONTACT_ENABLED=0
# No legal retention duration is selected; blank denies intake.
PUBLIC_CONTACT_RETENTION_DAYS=
# Required in production. Comma-separated Fernet keys, newest first, support rotation.
MFA_ENCRYPTION_KEYS=
# Optional platform-funded provider secrets; never expose these to the frontend.
OPENAI_API_KEY=
OPENAI_COMPATIBLE_API_KEY=
# Separate Fernet keys for provider credentials; API, provider workers and dedicated repository controller only.
PROVIDER_ENCRYPTION_KEYS=
# Repository intake stays disabled until dedicated isolation/security acceptance is recorded.
# Shared non-secret configuration on API/controller; no socket on application hosts.
REPOSITORY_ANALYSIS_ENABLED=0
# Separate explicit OSV package/version disclosure; requires operator privacy/capability acceptance.
REPOSITORY_ADVISORIES_ENABLED=0
REPOSITORY_ADVISORY_REVIEW_REFERENCE=
REPOSITORY_CONTROLLER_ID=
REPOSITORY_RUNNER_IMAGE=
REPOSITORY_ISOLATION_REVIEW_REFERENCE=
# Dedicated rootless host only; the standalone Compose template sets the container socket path.
REPOSITORY_CONTROLLER_HOST=0
REPOSITORY_DOCKER_SOCKET=/run/user/10001/docker.sock
# Standalone controller host only; immutable preloaded backend image, no API host effect.
REPOSITORY_CONTROLLER_IMAGE=
REPOSITORY_HOST_DOCKER_SOCKET=/run/user/10001/docker.sock
PRIVATE_REPOSITORY_BROKER_URL=
PRIVATE_REPOSITORY_CACHE_URL=
# Optional private Google Search Console OAuth client; API and default sync worker only.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_OAUTH_ENCRYPTION_KEYS=
# Yandex app client ID/callback and write-only secret are configured in staff admin.
YANDEX_OAUTH_ENCRYPTION_KEYS=
GOOGLE_ANALYTICS_REDIRECT_URI=
GOOGLE_ANALYTICS_ENCRYPTION_KEYS=
# Independent Fernet key list for sandbox/live Paddle seller keys; API only.
PADDLE_ENCRYPTION_KEYS=
# Server-selected billing environment; blank keeps owner checkout unavailable.
PADDLE_ENVIRONMENT=
# Exact approved Paddle default payment page on FRONTEND_ORIGIN; blank denies checkout.
PADDLE_CHECKOUT_URL=
# Keep irreversible self-service closure disabled until full P02-06 acceptance.
SELF_SERVICE_CLOSURE_ENABLED=0
# Account identity erasure/legal retention is still release-gated.
SELF_SERVICE_ACCOUNT_CLOSURE_ENABLED=0
# Staff account-identity cleanup stays unavailable until the reviewed policy is configured.
PERSONAL_IDENTITY_ERASURE_POLICY_REFERENCE=
PERSONAL_IDENTITY_TRIAL_RETENTION_DAYS=
# Stable private random key (at least 32 characters); preserve while retained fingerprints exist.
PERSONAL_IDENTITY_RETENTION_KEY=
# Restricted PageSpeed/CrUX project key; audit worker only (no public API activation yet).
GOOGLE_PERFORMANCE_API_KEY=
# Separate Fernet list for write-only performance keys; API and audit worker only.
PERFORMANCE_ENCRYPTION_KEYS=
# Local only. Production uses authenticated STARTTLS SMTP (API only); set a verified sender.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
# Private SES feedback queue and exact SNS topic; only default worker reads them.
SES_FEEDBACK_QUEUE_URL=
SES_FEEDBACK_TOPIC_ARN=
# Optional weekly delivery stays off until complete consumers and release evidence are checked.
# Same optional weekly rollout value on API/default worker only; keep off until release evidence passes.
WEEKLY_SUMMARY_DELIVERY_ENABLED=0
ALERT_DIGEST_DELIVERY_ENABLED=0
# Independent optional CrUX rollout on default worker only; native availability remains intent-only.
CRUX_ALERT_DELIVERY_ENABLED=0
DJANGO_CACHE_URL=redis://127.0.0.1:16379/1
POSTGRES_DB=organicseoops
POSTGRES_USER=organicseoops
POSTGRES_PASSWORD=
# Host Python talks to the isolated Docker development services on loopback.
# Compose overrides DB/Redis endpoints with private service addresses internally.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=15432
CELERY_BROKER_URL=redis://127.0.0.1:16379/0
# Local storage is a private shared Compose volume. Production uses s3 + IAM.
LOG_LEVEL=INFO
ARTIFACT_STORAGE_BACKEND=filesystem
ARTIFACT_MAX_BYTES=10485760
ARTIFACT_ALLOWED_CONTENT_TYPES=application/json,application/zip,text/csv,text/html,text/plain
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_PREFIX=artifacts
AWS_REGION=

# Reviewed READY-copy policy; leave both unset until approved. Applies only to new completed captures.
CUSTOMER_EXPORT_COPY_POLICY_REFERENCE=
CUSTOMER_EXPORT_COPY_LIFETIME_DAYS=
