{
  "name": "organicseoops-frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=11.13.0 <12"
  },
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build --configuration production && node checks/public-metadata.mjs",
    "test": "ng test --watch=false",
    "check:static": "node --test checks/*.test.mjs",
    "check": "npm test && npm run build && npm run check:static"
  },
  "dependencies": {
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/ssr": "22.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@types/node": "24.13.6",
    "jsdom": "30.1.0",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
