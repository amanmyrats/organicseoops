{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NoFeedbackQueueReadOnApplicationHost",
      "Effect": "Deny",
      "Action": ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"],
      "Resource": "arn:aws:sqs:${AWS_REGION}:${AWS_ACCOUNT_ID}:${SES_FEEDBACK_QUEUE_NAME}"
    }
  ]
}
