{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyPrivateArtifactPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${PRIVATE_ARTIFACT_BUCKET}",
      "Condition": { "StringLike": { "s3:prefix": ["${ARTIFACT_PREFIX}", "${ARTIFACT_PREFIX}/*"] } }
    },
    {
      "Sid": "ReadWriteOnlyPrivateArtifactObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload"],
      "Resource": "arn:aws:s3:::${PRIVATE_ARTIFACT_BUCKET}/${ARTIFACT_PREFIX}/*"
    }
  ]
}
