{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Private immutable backend ECR image repository; prepare only",
  "Resources": {
    "BackendRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": "organicseoops-backend",
        "ImageTagMutability": "IMMUTABLE",
        "EncryptionConfiguration": { "EncryptionType": "AES256" },
        "ImageScanningConfiguration": { "ScanOnPush": true },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Expire untagged images after 30 days\",\"selection\":{\"tagStatus\":\"untagged\",\"countType\":\"sinceImagePushed\",\"countUnit\":\"days\",\"countNumber\":30},\"action\":{\"type\":\"expire\"}}]}"
        }
      }
    },
    "RendererRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": "organicseoops-renderer",
        "ImageTagMutability": "IMMUTABLE",
        "EncryptionConfiguration": { "EncryptionType": "AES256" },
        "ImageScanningConfiguration": { "ScanOnPush": true },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Expire untagged images after 30 days\",\"selection\":{\"tagStatus\":\"untagged\",\"countType\":\"sinceImagePushed\",\"countUnit\":\"days\",\"countNumber\":30},\"action\":{\"type\":\"expire\"}}]}"
        }
      }
    },
    "PostgresRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": "organicseoops-postgres",
        "ImageTagMutability": "IMMUTABLE",
        "EncryptionConfiguration": { "EncryptionType": "AES256" },
        "ImageScanningConfiguration": { "ScanOnPush": true },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Expire untagged images after 30 days\",\"selection\":{\"tagStatus\":\"untagged\",\"countType\":\"sinceImagePushed\",\"countUnit\":\"days\",\"countNumber\":30},\"action\":{\"type\":\"expire\"}}]}"
        }
      }
    },
    "ProxyRepository": {
      "Type": "AWS::ECR::Repository",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "RepositoryName": "organicseoops-proxy",
        "ImageTagMutability": "IMMUTABLE",
        "EncryptionConfiguration": { "EncryptionType": "AES256" },
        "ImageScanningConfiguration": { "ScanOnPush": true },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Expire untagged images after 30 days\",\"selection\":{\"tagStatus\":\"untagged\",\"countType\":\"sinceImagePushed\",\"countUnit\":\"days\",\"countNumber\":30},\"action\":{\"type\":\"expire\"}}]}"
        }
      }
    }
  },
  "Outputs": {
    "RepositoryArn": { "Value": { "Fn::GetAtt": ["BackendRepository", "Arn"] } },
    "RepositoryUri": { "Value": { "Fn::GetAtt": ["BackendRepository", "RepositoryUri"] } },
    "RendererRepositoryArn": { "Value": { "Fn::GetAtt": ["RendererRepository", "Arn"] } },
    "RendererRepositoryUri": { "Value": { "Fn::GetAtt": ["RendererRepository", "RepositoryUri"] } },
    "PostgresRepositoryArn": { "Value": { "Fn::GetAtt": ["PostgresRepository", "Arn"] } },
    "PostgresRepositoryUri": { "Value": { "Fn::GetAtt": ["PostgresRepository", "RepositoryUri"] } },
    "ProxyRepositoryArn": { "Value": { "Fn::GetAtt": ["ProxyRepository", "Arn"] } },
    "ProxyRepositoryUri": { "Value": { "Fn::GetAtt": ["ProxyRepository", "RepositoryUri"] } }
  }
}
