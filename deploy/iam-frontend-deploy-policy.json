{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListOnlyFrontendBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::${FRONTEND_BUCKET_NAME}"
    },
    {
      "Sid": "UpdateOnlyFrontendObjects",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::${FRONTEND_BUCKET_NAME}/*"
    },
    {
      "Sid": "InvalidateOnlyFrontendDistribution",
      "Effect": "Allow",
      "Action": ["cloudfront:CreateInvalidation", "cloudfront:GetInvalidation"],
      "Resource": "arn:aws:cloudfront::${AWS_ACCOUNT_ID}:distribution/${FRONTEND_DISTRIBUTION_ID}"
    }
  ]
}
